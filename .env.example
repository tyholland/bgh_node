# Database (existing discrete vars, not a single DATABASE_URL)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB=
DB_SSL=false

# HTTP
PORT=
ALLOWED_ORIGINS=

# CSV ingest
CSV_SOURCE_URL=
INGEST_TRIGGER_SECRET=
INGEST_CRON=

# Frontend cache revalidation (called after a successful ingest run)
FRONTEND_REVALIDATE_URL=
REVALIDATE_SECRET=

# Contact form mail (Gmail app password) — also used for the saved-search
# digest email
SENDER_EMAIL=
GMAIL_APP_PASSWORD=
CONTACT_RECIPIENTS=
TURNSTILE_SECRET=

# Saved-search digest email (sent daily to users with saved searches)
FRONTEND_BASE_URL=
SAVED_SEARCH_DIGEST_CRON=

# Firebase Admin SDK service-account JSON (single-line), used to verify ID
# tokens on POST /v1/users and PATCH /v1/users/:uid
FIREBASE_SERVICE_ACCOUNT=

# Enrichment crawler
CRAWL_CONCURRENCY=
CRAWL_TIMEOUT_MS=
CRAWL_USER_AGENT=
DETAILS_OK_TTL_HOURS=
DETAILS_RETRY_HOURS=
