# Database (existing discrete vars, not a single DATABASE_URL)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB=
DB_SSL=false

# HTTP
PORT=8080
ALLOWED_ORIGINS=https://www.bghscout.com,https://bghscout.com,http://localhost:3000

# CSV ingest
CSV_SOURCE_URL=
INGEST_TRIGGER_SECRET=
INGEST_CRON=0 3,9,15,21 * * *

# Frontend cache revalidation (called after a successful ingest run)
FRONTEND_REVALIDATE_URL=https://www.bghscout.com/api/revalidate
REVALIDATE_SECRET=

# Contact form mail (Gmail API OAuth2 refresh-token creds)
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=
REFRESH_TOKEN=
SENDER_EMAIL=
CONTACT_RECIPIENTS=ty@heiprodigital.com,cpbeganski@gmail.com,ben@greenefamily.us
TURNSTILE_SECRET=

# Enrichment crawler
CRAWL_CONCURRENCY=6
CRAWL_TIMEOUT_MS=10000
CRAWL_USER_AGENT=Mozilla/5.0 (compatible; BghScoutBot/1.0; +https://www.bghscout.com)
DETAILS_OK_TTL_HOURS=168
DETAILS_RETRY_HOURS=6
